# Copy thành .env rồi chỉnh. KHÔNG commit file .env
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me
# Đường dẫn file SQLite (tương đối so với thư mục gốc dự án)
DATABASE_PATH=instance/app.db
# macOS AirPlay chiếm port 5000
FLASK_RUN_PORT=8000
# Thông tin cửa hàng
SITE_NAME=Cellphonfake
HOTLINE_SALES=1800.0000
HOTLINE_COMPLAINT=1800.0001
COMPANY_INFO=Công ty của bạn - Địa chỉ - Mã số doanh nghiệp
BANK_INFO=Vietcombank - STK 0000000000 - CONG TY CELLPHONFAKE
